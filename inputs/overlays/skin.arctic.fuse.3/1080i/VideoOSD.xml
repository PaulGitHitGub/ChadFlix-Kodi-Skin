<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">6001</defaultcontrol>
    <animation effect="fade" start="0" end="100" time="300" delay="200" condition="Window.IsActive(DialogSeekBar.xml) | Window.IsVisible(1152)">WindowOpen</animation>
    <animation effect="fade" start="0" end="100" time="300" condition="![Window.IsActive(DialogSeekBar.xml) | Window.IsVisible(1152)]">WindowOpen</animation>
    <animation effect="fade" end="0" start="100" time="300">WindowClose</animation>
    <onload>SetProperty(UID,$ESCINFO[Player.Title]$INFO[Player.Time(ss)],1147)</onload>
    <onunload>CancelAlarm(osd_timeout,true)</onunload>
    <!-- scrubber-finish: presentation state never outlives the OSD (the script also clears it; this is the safety net) -->
    <onunload>ClearProperty(Netflix.Scrub.UI,Home)</onunload>
    <onunload>ClearProperty(Netflix.Scrub.Owner,Home)</onunload>
    <onunload>ClearProperty(Netflix.Scrub.Header,Home)</onunload>
    <onunload>ClearProperty(Netflix.Scrub.Early,Home)</onunload>
    <onunload>ClearProperty(Netflix.Scrub.Fill,Home)</onunload>
    <onunload>ClearProperty(Netflix.Scrub.Nib,Home)</onunload>
    <onunload>ClearProperty(Netflix.Scrub.Time,Home)</onunload>
    <onunload>ClearProperty(Netflix.Scrub.Remaining,Home)</onunload>
    <controls>

        <control type="group">
            <include>Animation_OSD_HideForInfoDialog</include>
            <include>OSD_HideControls</include>

            <control type="group">
                <visible>!Window.IsActive(DialogPlayerProcessInfo.xml)</visible>
                <visible>!Window.IsVisible(DialogSlider.xml)</visible>
                <!-- scrubber-finish: playback buttons fade out while scrubbing and back in on exit (reversible mid-way) -->
                <animation effect="fade" start="100" end="0" time="200" tween="sine" easing="out" reversible="true" condition="![String.IsEmpty(Window(Home).Property(Netflix.Scrub.UI)) | String.IsEmpty(Window(Home).Property(Netflix.Scrub.Owner))]">Conditional</animation>

                <control type="group">
                    <!-- Left Side Buttons -->
                    <left>view_pad</left>
                    <right>view_pad</right>
                    <control type="grouplist" id="6091">
                        <centerbottom>80</centerbottom>
                        <height>120</height>
                        <left>-20</left>
                        <orientation>horizontal</orientation>
                        <itemgap>osd_itemgap</itemgap>
                        <!-- hidden 2026-11-12 by owner request; restore by removing this line (and changing onleft below back to 6008) -->
                        <!-- R8.4 order of the right group, left to right (R10.4: one Audio & Subtitles button): 6007 audio & subtitles, 6005 info (last): Left from Play wraps to 6005, Right from 6005 wraps to 6001 -->
                        <onleft>6005</onleft>
                        <onright>6007</onright>
                        <ondown>ActivateWindow($VAR[Action_OSD_Main_OnDown])</ondown>

                        <!-- Button 1 -->
                        <control type="button" id="6001">
                            <include>Defs_OSD_Button</include>
                            <onclick>PlayerControl(Play)</onclick>
                            <onfocus condition="Player.Forwarding | Player.Rewinding">PlayerControl(Play)</onfocus>
                            <onunfocus condition="Player.Forwarding | Player.Rewinding">PlayerControl(Play)</onunfocus>
                            <onup>8200</onup>
                        </control>
                        <include content="OSD_Button_Icon_Overlay">
                            <param name="icon">$VAR[Image_OSD_PlayPause_Netflix]</param>
                            <param name="id">6001</param>
                            <param name="groupid">6101</param>
                            <param name="itemgap">osd_itemgap</param>
                        </include>

                        <!-- Button 2 -->
                        <control type="button" id="6002">
                            <include>Defs_OSD_Button</include>
                            <onclick condition="VideoPlayer.Content(livetv)">CancelAlarm(osd_timeout,true)</onclick>
                            <onclick condition="VideoPlayer.Content(livetv)">Close</onclick>
                            <onclick condition="VideoPlayer.Content(livetv)">ActivateWindow(TVGuide)</onclick>
                            <!-- scrubber-finish: end a commit's target hold first, so the bar follows this seek -->
                            <onclick condition="!VideoPlayer.Content(livetv)">ClearProperty(Netflix.Scrub.Fill,Home)</onclick>
                            <onclick condition="!VideoPlayer.Content(livetv)">ClearProperty(Netflix.Scrub.Time,Home)</onclick>
                            <onclick condition="!VideoPlayer.Content(livetv)">ClearProperty(Netflix.Scrub.Remaining,Home)</onclick>
                            <onclick condition="!VideoPlayer.Content(livetv)">Seek(-10)</onclick>
                            <onup>8200</onup>
                        </control>
                        <include content="OSD_Button_Icon_Overlay" condition="!VideoPlayer.Content(livetv)">
                            <param name="icon">special://skin/extras/icons/osd/osd-replay-10.png</param>
                            <param name="id">6002</param>
                            <param name="groupid">6102</param>
                            <param name="itemgap">osd_itemgap</param>
                        </include>
                        <include content="OSD_Button_Icon_Overlay" condition="VideoPlayer.Content(livetv)">
                            <param name="icon">special://skin/extras/icons/list.png</param>
                            <param name="id">6002</param>
                            <param name="groupid">6102</param>
                            <param name="itemgap">osd_itemgap</param>
                        </include>

                        <!-- Button 3 -->
                        <control type="button" id="6003">
                            <include>Defs_OSD_Button</include>
                            <onclick condition="VideoPlayer.Content(livetv)">PVR.ToggleRecordPlayingChannel</onclick>
                            <onup>8200</onup>
                            <!-- scrubber-finish: end a commit's target hold first, so the bar follows this seek -->
                            <onclick condition="!VideoPlayer.Content(livetv)">ClearProperty(Netflix.Scrub.Fill,Home)</onclick>
                            <onclick condition="!VideoPlayer.Content(livetv)">ClearProperty(Netflix.Scrub.Time,Home)</onclick>
                            <onclick condition="!VideoPlayer.Content(livetv)">ClearProperty(Netflix.Scrub.Remaining,Home)</onclick>
                            <onclick condition="!VideoPlayer.Content(livetv)">Seek(10)</onclick>
                            <enable>PVR.CanRecordPlayingChannel | !VideoPlayer.Content(livetv)</enable>
                            <label>$VAR[Label_OSD_PVR_Recording]</label>
                        </control>
                        <include content="OSD_Button_Icon_Overlay" condition="!VideoPlayer.Content(livetv)">
                            <param name="icon">special://skin/extras/icons/osd/osd-forward-10.png</param>
                            <param name="id">6003</param>
                            <param name="groupid">6103</param>
                            <param name="itemgap">osd_itemgap</param>
                        </include>
                        <include content="OSD_Button_Icon_Overlay" condition="VideoPlayer.Content(livetv)">
                            <param name="icon">special://skin/extras/icons/record-vinyl.png</param>
                            <param name="id">6003</param>
                            <param name="groupid">6103</param>
                            <param name="itemgap">osd_itemgap</param>
                            <param name="iconoffset_condition">[PVR.IsRecordingPlayingChannel + PVR.CanRecordPlayingChannel]</param>
                        </include>

                        <!-- Button 4 -->
                        <control type="button" id="6004">
                            <include>Defs_OSD_Button</include>
                            <onclick>CancelAlarm(osd_timeout,true)</onclick>
                            <!-- staged/exit-confirm: Stop lands like Exit (no prompt): stop, then the title's page -->
                            <onclick>RunScript(special://skin/extras/netflix_exit_return.py,stop)</onclick>
                            <onup>8200</onup>
                        </control>
                        <include content="OSD_Button_Icon_Overlay">
                            <param name="icon">special://skin/extras/icons/osd/osd-stop.png</param>
                            <param name="id">6004</param>
                            <param name="groupid">6104</param>
                            <param name="itemgap">osd_itemgap</param>
                        </include>
                    </control>

                    <!-- Right Side Buttons -->
                    <control type="grouplist" id="6092">
                        <centerbottom>80</centerbottom>
                        <height>120</height>
                        <right>-20</right>
                        <orientation>horizontal</orientation>
                        <itemgap>osd_itemgap</itemgap>
                        <align>right</align>
                        <onleft>6004</onleft>
                        <onright>6001</onright>
                        <ondown>ActivateWindow($VAR[Action_OSD_Main_OnDown])</ondown>

                        <!-- Button 7: R10.4 one Audio & Subtitles button. Focus opens the combined card 1147 (its own copy of
                             this button takes focus; Up or OK there goes into Subtitles). Kodi's own audio / subtitle
                             settings are the last row of each "More" list in the card. -->
                        <control type="button" id="6007">
                            <include>Defs_OSD_Button</include>
                            <onup>ActivateWindow(1147)</onup>
                            <onfocus>ActivateWindow(1147)</onfocus>
                            <onclick>CancelAlarm(osd_timeout,true)</onclick>
                            <onclick>ActivateWindow(1147)</onclick>
                        </control>
                        <include content="OSD_Button_Icon_Overlay">
                            <param name="icon">special://skin/extras/icons/osd/osd-audio-subtitles.png</param>
                            <param name="id">6007</param>
                            <param name="groupid">6107</param>
                            <param name="itemgap">osd_itemgap</param>
                            </include>

                        <!-- Button 6 (audio) removed in R10.4: audio is the left column of the combined card 1147 -->

                        <!-- Button 5 -->
                        <control type="button" id="6005">
                            <include>Defs_OSD_Button</include>
                            <onup>ActivateWindow(1145)</onup>
                            <onfocus>ActivateWindow(1145)</onfocus>
                            <onclick>CancelAlarm(osd_timeout,true)</onclick>
                            <onclick>$VAR[Action_OSD_WikiInfo]</onclick>
                        </control>
                        <include content="OSD_Button_Icon_Overlay">
                            <param name="icon">special://skin/extras/icons/osd/osd-info.png</param>
                            <param name="id">6005</param>
                            <param name="groupid">6105</param>
                            <param name="itemgap">osd_itemgap</param>
                        </include>

                        <!-- Button 8 -->
                        <control type="button" id="6008">
                            <!-- hidden 2026-11-12 by owner request; restore by removing this line -->
                            <visible>false</visible>
                            <include>Defs_OSD_Button</include>
                            <onclick>CancelAlarm(osd_timeout,true)</onclick>
                            <onclick>ActivateWindow(osdvideosettings)</onclick>
                            <onup>ActivateWindow(1148)</onup>
                            <onfocus>ActivateWindow(1148)</onfocus>
                        </control>
                        <include content="OSD_Button_Icon_Overlay">
                            <param name="icon">special://skin/extras/icons/video.png</param>
                            <param name="id">6008</param>
                            <param name="groupid">6108</param>
                            <!-- hidden 2026-11-12 by owner request; restore by removing this line -->
                            <param name="group_visible">false</param>
                            <param name="itemgap">osd_itemgap</param>
                        </include>
                    </control>
                </control>

            </control>

            <control type="group">
                <left>view_osd_l</left>
                <right>view_osd_r</right>
                <height>112</height>
                <centerbottom>180</centerbottom>
                <control type="group">
                    <left>-56</left>
                    <right>-56</right>
                    <control type="progress">
                        <texturebg colordiffuse="00ffffff">progress/slider_bg.png</texturebg>
                        <righttexture colordiffuse="panel_fg_100">progress/slider_nib.png</righttexture>
                        <lefttexture />
                        <midtexture />
                        <info>Player.Progress</info>
                        <visible>Control.HasFocus(8200)</visible>
                        <visible>!Pvr.IsPlayingTv</visible>
                        <visible>String.IsEmpty(Window(Home).Property(Netflix.Scrub.Fill))</visible>
                    </control>
                    <!-- scrubber-finish: the scrub target's nib. Same textures and box as the native nib above; a ranges control
                         takes a float "LEFT,RIGHT" string from the script (computed to land on the native nib's pixels). -->
                    <control type="ranges" id="8201">
                        <info>Window(Home).Property(Netflix.Scrub.Nib)</info>
                        <texturebg colordiffuse="00ffffff">progress/slider_bg.png</texturebg>
                        <lefttexture />
                        <midtexture colordiffuse="panel_fg_100">progress/slider_nib.png</midtexture>
                        <righttexture />
                        <visible>!Pvr.IsPlayingTv</visible>
                        <!-- also while the timeline is focused and a finishing session still shows its target (re-entry
                             right after OK): the next session starts exactly there -->
                        <visible>!String.IsEmpty(Window(Home).Property(Netflix.Scrub.Fill)) + [![String.IsEmpty(Window(Home).Property(Netflix.Scrub.UI)) | String.IsEmpty(Window(Home).Property(Netflix.Scrub.Owner))] | Control.HasFocus(8200)]</visible>
                    </control>
                    <control type="progress">
                        <texturebg colordiffuse="00ffffff">progress/slider_bg.png</texturebg>
                        <righttexture colordiffuse="panel_fg_100">progress/slider_nib.png</righttexture>
                        <lefttexture />
                        <midtexture />
                        <info>PVR.EpgEventProgress</info>
                        <visible>Control.HasFocus(8202)</visible>
                        <visible>Pvr.IsPlayingTv</visible>
                    </control>
                    <!-- Enter one persistent scrub controller; directional input never seeks until OK. -->
                    <control type="button" id="8200">
                        <width>100%</width><height>112</height>
                        <label></label><texturefocus></texturefocus><texturenofocus></texturenofocus>
                        <!-- scrubber-finish: (conditions are all read before any action runs). UI = entry requested; the scrub
                             look also needs Netflix.Scrub.Owner, which only a live script sets. The 1 s alarm (AlarmClock's
                             smallest step) puts focus back on Play if no script ever starts; a running script cancels it.
                             A Header still held by a session that is finishing a commit is kept. -->
                        <onfocus condition="!Pvr.IsPlayingTv + Player.SeekEnabled + String.IsEmpty(Window(Home).Property(Netflix.Scrub.Returning)) + String.IsEmpty(Window(Home).Property(Netflix.Scrub.Header)) + Player.Paused">SetProperty(Netflix.Scrub.Header,paused,Home)</onfocus>
                        <onfocus condition="!Pvr.IsPlayingTv + Player.SeekEnabled + String.IsEmpty(Window(Home).Property(Netflix.Scrub.Returning)) + String.IsEmpty(Window(Home).Property(Netflix.Scrub.Header)) + !Player.Paused">SetProperty(Netflix.Scrub.Header,playing,Home)</onfocus>
                        <onfocus condition="!Pvr.IsPlayingTv + Player.SeekEnabled + String.IsEmpty(Window(Home).Property(Netflix.Scrub.Returning))">SetProperty(Netflix.Scrub.UI,1,Home)</onfocus>
                        <onfocus condition="!Pvr.IsPlayingTv + Player.SeekEnabled + String.IsEmpty(Window(Home).Property(Netflix.Scrub.Returning))">CancelAlarm(netflixscrubsafe,true)</onfocus>
                        <onfocus condition="!Pvr.IsPlayingTv + Player.SeekEnabled + String.IsEmpty(Window(Home).Property(Netflix.Scrub.Returning))">AlarmClock(netflixscrubsafe,SetFocus(6001),00:01,silent)</onfocus>
                        <onfocus condition="!Pvr.IsPlayingTv + Player.SeekEnabled + String.IsEmpty(Window(Home).Property(Netflix.Scrub.Returning))">RunScript(special://skin/extras/netflix_scrub.py)</onfocus>
                        <onfocus condition="!Pvr.IsPlayingTv + !Player.SeekEnabled">SetFocus(6001)</onfocus>
                        <onfocus condition="Pvr.IsPlayingTv">SetFocus(8202)</onfocus>
                        <onunfocus>ClearProperty(Netflix.Scrub.UI,Home)</onunfocus>
                        <!-- no session at all (script never ran, or gave up): the held header goes too -->
                        <onunfocus condition="String.IsEmpty(Window(Home).Property(Netflix.Scrub.Active))">ClearProperty(Netflix.Scrub.Header,Home)</onunfocus>
                        <!-- a press before the scrubber has taken input (script start-up) is kept, not lost -->
                        <onleft>SetProperty(Netflix.Scrub.Early,-1,Home)</onleft>
                        <onright>SetProperty(Netflix.Scrub.Early,1,Home)</onright>
                        <!-- a control id, not SetFocus(): only a navigation target counts as handled, a builtin would let
                             Back fall through to the window and close the OSD (CGUIWindow::OnMove) -->
                        <onback>6001</onback>
                        <onup>noop</onup>
                        <ondown>6091</ondown>
                    </control>
                    <control type="slider" id="8202">
                        <visible>Pvr.IsPlayingTv</visible>
                        <info>Player.Progress</info>
                        <action>seek</action>
                        <texturesliderbar />
                        <textureslidernib />
                        <textureslidernibfocus />
                        <ondown>6091</ondown>
                    </control>
                </control>
            </control>
            <!-- R10.3 (owner, 13 Nov): the play-bar Skip Intro button (8210) is gone; POV's pop-up is the only Skip Intro -->
        </control>
    </controls>
</window>