            <onleft>noop</onleft>
            <onright>noop</onright>
            <onup>4100</onup>
            <ondown>4100</ondown>
            <scrolltime tween="quadratic">120</scrolltime>
            <itemlayout width="436" height="62">
                <control type="image">
                    <left>-2</left>
                    <top>-1</top>
