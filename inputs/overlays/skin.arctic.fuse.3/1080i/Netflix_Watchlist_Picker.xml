                    <height>64</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="FFB9B9BE">$INFO[ListItem.Art(icon)]</texture>
                    <visible>!ListItem.IsSelected</visible>
                </control>
                <control type="image">
                    <left>-2</left>
                    <top>-1</top>
                    <width>64</width>
                    <height>64</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="FFF5F5F5">special://skin/extras/icons/square-check-regular.png</texture>
                    <visible>ListItem.IsSelected</visible>
                </control>
                <control type="label">
                    <left>61</left>
                    <top>0</top>
                    <width>350</width>
                    <height>62</height>
                    <font>font_main</font>
                    <textcolor>FFF5F5F5</textcolor>
                    <aligny>center</aligny>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="436" height="62">
                <control type="image">
                    <width>436</width>
                    <height>62</height>
                    <texture border="24" colordiffuse="FFF5F5F5">common/box.png</texture>
                </control>
                <control type="image">
                    <left>-2</left>
                    <top>-1</top>
                    <width>64</width>
                    <height>64</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="FF101012">$INFO[ListItem.Art(icon)]</texture>
                    <visible>!ListItem.IsSelected</visible>
                </control>
                <control type="image">
                    <left>-2</left>
                    <top>-1</top>
                    <width>64</width>
                    <height>64</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="FF101012">special://skin/extras/icons/square-check-regular.png</texture>
                    <visible>ListItem.IsSelected</visible>
