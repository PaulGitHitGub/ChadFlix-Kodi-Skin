<?xml version="1.0" encoding="UTF-8"?>
<window>
    <zorder>1000</zorder>
    <!-- R10.7-voice-logo: Kodi's speech toasts (caption 39177 "Speech to text") are never drawn (see the <visible> below);
         the Search page's Voice Search pill shows listening and failure instead.
         onload conditions cannot read this toast's own labels (Kodi evaluates them in the active window's context), so
         a voice search is followed by sequence: while Netflix.SearchVoiceActive (DialogKeyboard.xml), the FIRST toast
         window opened is Kodi's "Listening..." (mic open) and is closed at once (so the next toast opens the window
         again and runs this onload); a LATER one is Kodi's speech error (a recognised result never queues a toast):
         flag the failure for the pill (3 s), close the hidden keyboard now by re-arming its timeout alarm at 0 s
         instead of after 18 s, and close the (hidden) toast. -->
    <onload condition="String.IsEqual(Window(Home).Property(Netflix.SearchVoiceActive),true) + Window.IsVisible(1105) + !String.IsEqual(Window(Home).Property(Netflix.SearchVoiceToastSeen),true)">SetProperty(Netflix.SearchVoiceToastSeen,true,Home)</onload>
    <onload condition="String.IsEqual(Window(Home).Property(Netflix.SearchVoiceActive),true) + Window.IsVisible(1105) + String.IsEqual(Window(Home).Property(Netflix.SearchVoiceToastSeen),true)">SetProperty(Netflix.SearchVoiceFailed,true,Home)</onload>
    <onload condition="String.IsEqual(Window(Home).Property(Netflix.SearchVoiceActive),true) + Window.IsVisible(1105) + String.IsEqual(Window(Home).Property(Netflix.SearchVoiceToastSeen),true)">AlarmClock(NetflixSearchVoiceFailedClear,ClearProperty(Netflix.SearchVoiceFailed,Home),00:03,silent)</onload>
    <onload condition="String.IsEqual(Window(Home).Property(Netflix.SearchVoiceActive),true) + Window.IsVisible(1105) + String.IsEqual(Window(Home).Property(Netflix.SearchVoiceToastSeen),true)">AlarmClock(NetflixSearchVoiceTimeout,Action(Back,virtualkeyboard),00:00,silent)</onload>
    <onload condition="String.IsEqual(Window(Home).Property(Netflix.SearchVoiceActive),true) + Window.IsVisible(1105)">AlarmClock(NetflixSpeechToastClose,Dialog.Close(10107,true),00:00,silent)</onload>
    <controls>

        <control type="group">
            <visible>!String.IsEqual(Control.GetLabel(401),$LOCALIZE[39177])</visible>

            <!-- R10.55: the toast sits on the skin's dark panel (common/box.png FA08090B, as the Options dialog) instead of bare
                 text over the art, and while the mute / volume icon is up (DialogVolumeBar, same corner) the whole toast
                 rises above it instead of running into it; while the Next Episode card is up it rises above the card (review L2).
                 One-line toasts get a one-line panel centred on the icon (review L4). -->
            <animation effect="slide" start="0,0" end="0,-96" time="200" tween="sine" easing="out" condition="Window.IsVisible(DialogVolumeBar.xml) + !Window.IsVisible(netflix_next_episode.xml)">Conditional</animation>
            <animation effect="slide" start="0,0" end="0,-168" time="200" tween="sine" easing="out" condition="Window.IsVisible(netflix_next_episode.xml)">Conditional</animation>
            <include content="Furniture_Busy_Main">
                <param name="minilabel">$INFO[Control.GetLabel(402)]</param>
                <param name="mainlabel">$INFO[Control.GetLabel(401)]</param>
                <param name="haslabel">false</param>
                <param name="visible_condition">!$EXP[Exp_FurnitureBusy_AnimationCond_DialogNotification]</param>
                <param name="windowopen_condition">!$EXP[Exp_FurnitureBusy_AnimationCond_DialogNotification]</param>
            </include>
            <!-- The panel: one disabled auto-width button per line (transparent text, same font and label as the line it
                 measures), right-aligned at the same edge; the wider one is the panel, the narrower lies inside it. -->
            <control type="grouplist">
                <left>-80</left>
                <right>84</right>
                <top>-8</top>
                <height>96</height>
                <orientation>horizontal</orientation>
                <align>right</align>
                <usecontrolcoords>true</usecontrolcoords>
                <visible>!String.IsEmpty(Control.GetLabel(402))</visible>
                <control type="button">
                    <width min="0" max="666">auto</width>
                    <height>96</height>
                    <enable>false</enable>
                    <font>font_main_bold</font>
                    <label>$INFO[Control.GetLabel(401)]</label>
                    <textoffsetx>26</textoffsetx>
                    <textcolor>00FFFFFF</textcolor>
                    <disabledcolor>00FFFFFF</disabledcolor>
                    <texturenofocus border="24" colordiffuse="FA08090B">common/box.png</texturenofocus>
                    <texturefocus border="24" colordiffuse="FA08090B">common/box.png</texturefocus>
                </control>
            </control>
            <control type="grouplist">
                <left>-80</left>
                <right>84</right>
                <top>-8</top>
                <height>96</height>
                <orientation>horizontal</orientation>
                <align>right</align>
                <usecontrolcoords>true</usecontrolcoords>
                <visible>!String.IsEmpty(Control.GetLabel(402))</visible>
                <control type="button">
                    <width min="0" max="666">auto</width>
                    <height>96</height>
                    <enable>false</enable>
                    <font>font_hint_bold</font>
                    <label>$INFO[Control.GetLabel(402)]</label>
                    <textoffsetx>26</textoffsetx>
                    <textcolor>00FFFFFF</textcolor>
                    <disabledcolor>00FFFFFF</disabledcolor>
                    <texturenofocus border="24" colordiffuse="FA08090B">common/box.png</texturenofocus>
                    <texturefocus border="24" colordiffuse="FA08090B">common/box.png</texturefocus>
                </control>
            </control>
            <!-- one line only: a 56 px panel centred on the toast's icon -->
            <control type="grouplist">
                <left>-80</left>
                <right>84</right>
                <top>12</top>
                <height>56</height>
                <orientation>horizontal</orientation>
                <align>right</align>
                <usecontrolcoords>true</usecontrolcoords>
                <visible>String.IsEmpty(Control.GetLabel(402))</visible>
                <control type="button">
                    <width min="0" max="666">auto</width>
                    <height>56</height>
                    <enable>false</enable>
                    <font>font_main_bold</font>
                    <label>$INFO[Control.GetLabel(401)]</label>
                    <textoffsetx>26</textoffsetx>
                    <textcolor>00FFFFFF</textcolor>
                    <disabledcolor>00FFFFFF</disabledcolor>
                    <texturenofocus border="24" colordiffuse="FA08090B">common/box.png</texturenofocus>
                    <texturefocus border="24" colordiffuse="FA08090B">common/box.png</texturefocus>
                </control>
            </control>
            <control type="label">
                <left>-4</left>
                <right>110</right>
                <top>20</top>
                <height>40</height>
                <font>font_main_bold</font>
                <textcolor>main_fg_90</textcolor>
                <label>$INFO[Control.GetLabel(401)]</label>
                <align>right</align>
                <aligny>center</aligny>
                <visible>String.IsEmpty(Control.GetLabel(402))</visible>
            </control>
            <!-- the two lines, as Furniture_Busy_FloatingText drew them (main above, small line below), 26 px inside the panel -->
            <control type="label">
                <visible>!String.IsEmpty(Control.GetLabel(402))</visible>
                <left>-4</left>
                <right>110</right>
                <top>6</top>
                <height>40</height>
                <font>font_main_bold</font>
                <textcolor>main_fg_90</textcolor>
                <label>$INFO[Control.GetLabel(401)]</label>
                <align>right</align>
                <aligny>center</aligny>
            </control>
            <control type="label">
                <left>-4</left>
                <right>110</right>
                <top>42</top>
                <height>32</height>
                <font>font_hint_bold</font>
                <textcolor>main_fg_70</textcolor>
                <label>$INFO[Control.GetLabel(402)]</label>
                <align>right</align>
                <aligny>center</aligny>
            </control>

            <include content="Furniture_Busy_Base">
                <param name="hasicon">false</param>
            </include>

            <!-- Left -->
            <include content="Furniture_ItemIcon">
                <param name="icon">special://skin/extras/icons/comment-dots.png</param>
                <param name="flipped">true</param>
                <param name="right">15</param>
                <param name="visible">String.StartsWith(Control.GetLabel(400),Default)</param>
                <param name="size">50</param>
            </include>
            <include content="Furniture_ItemIcon">
                <param name="icon">$INFO[Control.GetLabel(400)]</param>
                <param name="icon_colordiffuse">white</param>
                <param name="bordersize">2</param>
                <param name="flipped">true</param>
                <param name="right">15</param>
                <param name="visible">!String.StartsWith(Control.GetLabel(400),Default)</param>
                <param name="size">50</param>
            </include>
        </control>

        <control type="image" id="400">
            <include>Object_Hidden_Item_Definition</include>
        </control>
        <control type="label" id="401">
            <include>Object_Hidden_Item_Definition</include>
        </control>
        <control type="label" id="402">
            <include>Object_Hidden_Item_Definition</include>
        </control>
    </controls>
</window>
