<?xml version="1.0" encoding="UTF-8"?>
<window>
    <zorder>0</zorder>
    <visible>Window.IsActive(VideoFullScreen.xml) | Window.IsActive(MusicVisualisation.xml)</visible>

    <visible>[Player.Paused + [!$EXP[Exp_OSD_DelayInfo_Timing] | !Skin.String(OSD.AutoOnPause,Hide)]] | Player.Caching | Player.Seeking | Player.HasPerformedSeek(2) | Player.Forwarding | Player.Rewinding | !String.IsEmpty(Player.SeekNumeric) | !String.IsEmpty(PVR.ChannelNumberInput) | Window.IsActive(script-upnext-stillwatching.xml) | Window.IsActive(script-upnext-upnext.xml) | Window.IsActive(videoosd) | Window.IsActive(musicosd) | Window.IsActive(1140) | Window.IsActive(1141) | Window.IsActive(1142) | Window.IsActive(1143) | Window.IsActive(1144) | Window.IsActive(1145) | Window.IsActive(1146) | Window.IsActive(1147) | Window.IsActive(1148) | Window.IsActive(1149) | Window.IsActive(1152) | Window.IsVisible(videobookmarks) | Window.IsVisible(pvrosdguide) | Window.IsVisible(pvrosdchannels) | [Window.IsVisible(script-cu-lrclyrics-main.xml) + Player.ShowInfo]</visible>

    <visible>!Window.IsActive(DialogSlider.xml)</visible>
    <!-- staged/exit-confirm: the paused bar must not sit under the exit prompt, nor flash while Exit/Stop is stopping
         (Back on the prompt starts the prompt's close at once; Netflix.Exit.Go/Running last until the player is gone) -->
    <visible>!Window.IsActive(1178) + String.IsEmpty(Window(Home).Property(Netflix.Exit.Go)) + String.IsEmpty(Window(Home).Property(Netflix.Exit.Running))</visible>
    <visible>!Player.HasGame</visible>
    <visible>!Window.IsVisible(DialogPlayerProcessInfo.xml)</visible>

    <animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="300">WindowClose</animation>
    <controls>

        <control type="group">
            <visible>Window.IsActive(VideoFullScreen.xml) | Window.IsActive(MusicVisualisation.xml)</visible>

            <include>OSD_BackgroundFade_Seekbar</include>

            <control type="group">
                <visible>!Window.IsVisible(1152)</visible>
                <include>Animation_OSD_Fullscreen_Change</include>

                <control type="group">
                    <include>Animation_OSD_HideForInfoDialog</include>
                    <control type="group">
                        <include>Animation_OSD_Seekbar_Slide</include>
                        <include>OSD_Progress_Labels</include>
                        <include>OSD_Progress_Bar</include>

                        <control type="group">
                            <include>OSD_HideControls</include>
                            <!-- R10.3: status label in scrub mode reads "Jump to" (same fades as the helper swap below) -->
                            <control type="group">
                                <animation effect="fade" start="100" end="0" time="120" tween="sine" easing="out" reversible="false" condition="![String.IsEmpty(Window(Home).Property(Netflix.Scrub.UI)) | String.IsEmpty(Window(Home).Property(Netflix.Scrub.Owner))]">Conditional</animation>
                                <animation effect="fade" start="0" end="100" delay="120" time="160" tween="sine" easing="out" reversible="false" condition="[String.IsEmpty(Window(Home).Property(Netflix.Scrub.UI)) | String.IsEmpty(Window(Home).Property(Netflix.Scrub.Owner))]">Conditional</animation>
                                <include content="Furniture_Header">
                                    <param name="label">$VAR[Label_OSD_Header]</param>
                                    <param name="include_right">false</param>
                                    <param name="textcolor">panel_fg_90</param>
                                    <param name="top">780</param>
                                </include>
                            </control>
                            <control type="group">
                                <visible>Window.IsActive(videoosd) + ![String.IsEmpty(Window(Home).Property(Netflix.Scrub.UI)) | String.IsEmpty(Window(Home).Property(Netflix.Scrub.Owner))]</visible>
                                <animation effect="fade" start="0" end="100" delay="120" time="160" tween="sine" easing="out" reversible="true">Visible</animation>
                                <animation effect="fade" start="100" end="0" time="120" tween="sine" easing="out" reversible="true">Hidden</animation>
                                <include content="Furniture_Header">
                                    <param name="label">Jump To</param>
                                    <param name="include_right">false</param>
                                    <param name="textcolor">panel_fg_90</param>
                                    <param name="top">780</param>
                                </include>
                            </control>
                        </control>
                    </control>

                    <!-- R10.55 (owner rule: no remote-button hint rows): the OSD hint row ("Press down: Bookmarks and Chapters" /
                         "Playlist" / "Cast and More Info"), the Jump To row's "OK to Play Here · Back to Cancel" and the music OSD
                         hint are gone. The Jump To header above is kept. -->
                </control>

                <!-- R8.4: the top-right clock is now "Ends at <finish time>" (same group/line/label/font as Furniture_Header_Right);
                     hidden when Player.FinishTime is empty (live streams) -->
                <control type="group">
                    <top>40</top>
                    <height>80</height>
                    <left>view_pad</left>
                    <right>view_pad</right>
                    <visible>!String.IsEmpty(Player.FinishTime)</visible>
                    <control type="group">
                        <right>0</right>
                        <width>720</width>
                        <include content="View_Line_Divider">
                            <param name="align">right</param>
                        </include>
                        <control type="label">
                            <label>Ends at $INFO[Player.FinishTime]</label>
                            <align>right</align>
                            <aligny>center</aligny>
                            <textcolor>panel_fg_90</textcolor>
                            <font>font_midi_bold</font>
                            <height>80</height>
                        </control>
                    </control>
                </control>


            </control>
        </control>

    </controls>
</window>