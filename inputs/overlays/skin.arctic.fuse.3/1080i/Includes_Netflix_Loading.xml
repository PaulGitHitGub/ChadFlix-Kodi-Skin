<?xml version="1.0" encoding="UTF-8"?>
<!-- R10.12-loading-look: ONE look for every card-shaped wait (design: staged/loading-look-design/DESIGN.md, Option B).
     Rules, all from here:
       fill     FF141414 (R10.56; R10.12 used FF222222, the grey under every loaded poster)
       shape    the SAME diffuse mask as the loaded art (poster, landscape, square = common/white.png)
       in/out   instant in; the host's group fades it out in 120 ms (every host group carries that Hidden animation)
       sliver   kept in the scroll direction by the host (rows: the 6th card is cut by the screen edge)
       sweep    ONE moving highlight per card row (Netflix_Loading_Sweep below), only after 400 ms of waiting (the GIF's first 10 frames are flat)
     R10.56-loading-look (owner's pick A, "Quiet shimmer", 20 Nov): fill FF141414 (was FF222222), and the sweep is back, slower and fainter:
       extras/loading/sweep-dark-row.gif / sweep-dark-col.gif, #141414 -> #1F1F1F, flat for its first 600 ms (frame 0), one pass, 3.4 s loop,
       always through the card-shaped masks (never in the gaps). My Lists' rows have it too (Includes_Home.xml, masks mask-ml-*.png).
     FALLBACK "A flat" (no motion, dark cards): delete the ONE line marked "A-FLAT" inside Netflix_Loading_Sweep below (its <definition> is then
       empty). Nothing else changes: the masks / GIFs simply stop being used. -->
<includes>

    <!-- One flat card. mask: the final art's diffuse mask (square card: leave the default, an opaque white image). -->
    <include name="Netflix_Loading_Card">
        <param name="left">0</param>
        <param name="top">0</param>
        <param name="width">303</param>
        <param name="height">489</param>
        <param name="mask">diffuse/poster_w560_h820.png</param>
        <param name="visible">true</param>
        <definition>
            <control type="image">
                <left>$PARAM[left]</left><top>$PARAM[top]</top><width>$PARAM[width]</width><height>$PARAM[height]</height>
                <texture diffuse="$PARAM[mask]" colordiffuse="FF141414">common/white.png</texture>
                <visible>$PARAM[visible]</visible>
            </control>
        </definition>
    </include>

    <!-- A heading stub: the same fill, rounded ends (it replaces FF24262C rectangles). -->
    <include name="Netflix_Loading_Stub">
        <param name="left">0</param>
        <param name="top">0</param>
        <param name="width">150</param>
        <param name="height">22</param>
        <definition>
            <control type="image">
                <left>$PARAM[left]</left><top>$PARAM[top]</top><width>$PARAM[width]</width><height>$PARAM[height]</height>
                <texture border="11" colordiffuse="FF141414">special://skin/extras/loading/stub-pill.png</texture>
            </control>
        </definition>
    </include>

    <!-- THE SWEEP (one control per card row; remove its <definition> content to get Option A).
         A tiny grey animated GIF (extras/loading/sweep-dark-*.gif: the card fill with a soft lighter band travelling left to right) is stretched over
         the row and shown through `mask`, a PNG with the row's card shapes. The highlight therefore exists only inside the cards: never in the margin,
         the gaps or over the fanart.
         "Only if the wait lasts more than 400 ms": the GIF restarts at its first frame every time this control is shown (measured on Kodi 21), and its
         first 10 frames (400 ms) are the plain card fill, so a fast or cached load never shows light; then one sweep, then it loops (about 2 s).
         (A Visible animation with a delay was tried first: Kodi replays it for the first reveal after a skin load only, not for later ones.)
         `condition` must be the host's FULL visibility gate (the host group's own <visible> plus whatever hides or slides the host away, e.g. the parent
         slot's visibility and Netflix_Grid_Over): a control only changes state while it is processed, so a gate that stays true behind a hidden parent
         would leave a resident, stepping GIF and no restart on the next reveal. The control leaves with a 100 ms fade (the hosts' cards use 120 ms,
         so the light is gone first).
         left/top/width/height: the row box in screen pixels (the mask PNG covers exactly this box).
         mask / gif: file names under special://skin/extras/loading/ -->
    <include name="Netflix_Loading_Sweep">
        <param name="left">0</param>
        <param name="top">0</param>
        <param name="width">1920</param>
        <param name="height">489</param>
        <param name="mask">mask-browse-row.png</param>
        <param name="gif">sweep-dark-row.gif</param>
        <param name="condition">true</param>
        <definition>
            <!-- A-FLAT: delete the next line (and only it) to turn the sweep off everywhere. -->
            <control type="image"><left>$PARAM[left]</left><top>$PARAM[top]</top><width>$PARAM[width]</width><height>$PARAM[height]</height><texture diffuse="special://skin/extras/loading/$PARAM[mask]">special://skin/extras/loading/$PARAM[gif]</texture><visible>$PARAM[condition]</visible><animation effect="fade" start="100" end="0" time="100">Hidden</animation></control>
        </definition>
    </include>

    <!-- A row of 6 poster cards (303x489, pitch 320, first at x 70, the 6th cut by the screen edge) in a group whose top is `top`:
         the Movies / Shows tab-switch cards (MyVideoNav.xml, top 192 and 966), Customize Home's reloading rows and the home rows that are still
         loading (Includes_Search.xml / Includes_Home.xml, top 62). The row mask is aligned to screen x 0: the host group must sit at left 0.
         ring: a condition; while it is true the first card is drawn as the focused poster (white outline, drawn last, so it covers the sweep). -->
    <include name="Netflix_Loading_Poster_Row">
        <param name="top">192</param>
        <param name="condition">true</param>
        <param name="ring">false</param>
        <param name="ring_left">70</param>
        <param name="ring_inner">74</param>
        <definition>
            <control type="group">
                <left>0</left><top>$PARAM[top]</top>
                <include content="Netflix_Loading_Card"><param name="left">70</param><param name="visible">![$PARAM[ring]]</param></include>
                <include content="Netflix_Loading_Card"><param name="left">390</param></include>
                <include content="Netflix_Loading_Card"><param name="left">710</param></include>
                <include content="Netflix_Loading_Card"><param name="left">1030</param></include>
                <include content="Netflix_Loading_Card"><param name="left">1350</param></include>
                <include content="Netflix_Loading_Card"><param name="left">1670</param></include>
                <include content="Netflix_Loading_Sweep">
                    <param name="condition">$PARAM[condition]</param>
                </include>
                <control type="image">
                    <left>$PARAM[ring_left]</left><top>0</top><width>303</width><height>489</height>
                    <texture diffuse="diffuse/poster_w560_h820.png" colordiffuse="FFF5F5F5">common/white.png</texture>
                    <visible>$PARAM[ring]</visible>
                </control>
                <control type="image">
                    <left>$PARAM[ring_inner]</left><top>4</top><width>295</width><height>481</height>
                    <texture diffuse="diffuse/poster_w560_h820.png" colordiffuse="FF141414">common/white.png</texture>
                    <visible>$PARAM[ring]</visible>
                </control>
            </control>
        </definition>
    </include>

    <!-- When the Movies / Shows tab-switch cards (MyVideoNav.xml) are up: the moment Left/Right is pressed on the top tabs
         until the new tab's rows arrive. One expression, used by the host group AND by its sweeps.
         R10.56: never for a dwell onto My Lists (3734): that page is another window with its own skeleton; the Movies/Shows layout was wrong there. -->
    <expression name="Netflix_Loading_Tab_Overlay">[$EXP[Netflix_Movies_Catalog] | $EXP[Netflix_Shows_Catalog]] + $EXP[Netflix_Tab_Pending] + !String.IsEqual(Window(Home).Property(Netflix.TabDwellTarget),3734) + !String.IsEqual(Window(Home).Property(Netflix.MoviesBoot.Pending),true)</expression>

    <!-- Show page, season / episode cards (Netflix_Series.xml, group at left 784 top 153): 3 cards 437x247, pitch 272, in the
         episode list's cells (3 px in), the loaded still's mask (landscape, corner 17), and the 55 px sliver of the 4th card the
         loaded list shows before its clip at y 1024 (round top corners, flat cut). One sweep for the whole column. -->
    <include name="Netflix_Loading_Episode_Column">
        <param name="condition">true</param>
        <definition>
            <include content="Netflix_Loading_Card"><param name="left">3</param><param name="top">0</param><param name="width">437</param><param name="height">247</param><param name="mask">diffuse/landscape_w410_h231.png</param></include>
            <include content="Netflix_Loading_Card"><param name="left">3</param><param name="top">272</param><param name="width">437</param><param name="height">247</param><param name="mask">diffuse/landscape_w410_h231.png</param></include>
            <include content="Netflix_Loading_Card"><param name="left">3</param><param name="top">544</param><param name="width">437</param><param name="height">247</param><param name="mask">diffuse/landscape_w410_h231.png</param></include>
            <include content="Netflix_Loading_Card"><param name="left">3</param><param name="top">816</param><param name="width">437</param><param name="height">55</param><param name="mask">special://skin/extras/loading/mask-landscape-sliver.png</param></include>
            <include content="Netflix_Loading_Sweep">
                <param name="left">3</param><param name="top">0</param><param name="width">437</param><param name="height">871</param>
                <param name="mask">mask-episode-col.png</param><param name="gif">sweep-dark-col.gif</param>
                <param name="condition">$PARAM[condition]</param>
            </include>
        </definition>
    </include>

