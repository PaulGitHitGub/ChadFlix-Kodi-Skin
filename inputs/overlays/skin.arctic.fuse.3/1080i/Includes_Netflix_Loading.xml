            <include content="Netflix_Loading_Card"><param name="left">264</param><param name="top">0</param><param name="width">240</param><param name="height">350</param><param name="mask">diffuse/poster_w240_h351.png</param></include>
            <include content="Netflix_Loading_Card"><param name="left">528</param><param name="top">0</param><param name="width">240</param><param name="height">350</param><param name="mask">diffuse/poster_w240_h351.png</param></include>
            <include content="Netflix_Loading_Card"><param name="left">792</param><param name="top">0</param><param name="width">240</param><param name="height">350</param><param name="mask">diffuse/poster_w240_h351.png</param></include>
            <include content="Netflix_Loading_Card"><param name="left">0</param><param name="top">388</param><param name="width">240</param><param name="height">350</param><param name="mask">diffuse/poster_w240_h351.png</param></include>
            <include content="Netflix_Loading_Card"><param name="left">264</param><param name="top">388</param><param name="width">240</param><param name="height">350</param><param name="mask">diffuse/poster_w240_h351.png</param></include>
            <include content="Netflix_Loading_Card"><param name="left">528</param><param name="top">388</param><param name="width">240</param><param name="height">350</param><param name="mask">diffuse/poster_w240_h351.png</param></include>
            <include content="Netflix_Loading_Card"><param name="left">792</param><param name="top">388</param><param name="width">240</param><param name="height">350</param><param name="mask">diffuse/poster_w240_h351.png</param></include>
            <include content="Netflix_Loading_Card"><param name="left">0</param><param name="top">776</param><param name="width">240</param><param name="height">26</param><param name="mask">special://skin/extras/loading/mask-poster-sliver-240.png</param></include>
            <include content="Netflix_Loading_Card"><param name="left">264</param><param name="top">776</param><param name="width">240</param><param name="height">26</param><param name="mask">special://skin/extras/loading/mask-poster-sliver-240.png</param></include>
            <include content="Netflix_Loading_Card"><param name="left">528</param><param name="top">776</param><param name="width">240</param><param name="height">26</param><param name="mask">special://skin/extras/loading/mask-poster-sliver-240.png</param></include>
            <include content="Netflix_Loading_Card"><param name="left">792</param><param name="top">776</param><param name="width">240</param><param name="height">26</param><param name="mask">special://skin/extras/loading/mask-poster-sliver-240.png</param></include>
            <include content="Netflix_Loading_Sweep">
                <param name="left">0</param><param name="top">0</param><param name="width">1032</param><param name="height">802</param>
                <param name="mask">mask-related-grid.png</param><param name="gif">sweep-dark-row.gif</param>
                <param name="condition">$PARAM[condition]</param>
            </include>
        </definition>
    </include>

