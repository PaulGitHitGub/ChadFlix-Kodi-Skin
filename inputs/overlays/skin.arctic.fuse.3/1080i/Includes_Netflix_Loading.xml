            <include content="Netflix_Loading_Card"><param name="left">542</param><param name="top">102</param><param name="width">220</param><param name="height">330</param><param name="mask">diffuse/poster_w480_h720.png</param><param name="visible">String.IsEmpty(Skin.String(Netflix.CW.Count.$PARAM[id])) | Integer.IsGreater(Skin.String(Netflix.CW.Count.$PARAM[id]),2)</param></include>
