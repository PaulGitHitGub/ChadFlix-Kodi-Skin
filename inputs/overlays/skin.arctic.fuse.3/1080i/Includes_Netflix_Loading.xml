    <!-- Continue Watching, while its row is loading and was non-empty last time (Includes_Search.xml, Netflix_Continue_Row group; its list sits at
         top 102): up to 8 poster cards 220x330 (pitch 236, first at x 70, the 8th cut by the screen edge) in the loaded tile's mask.
         R10.56: as many cards as the row had last time (Skin.String(Netflix.CW.Count.<id>), kept by the netflix_cw_remember_<id> timers; 8 when not
         known yet), and the sweep through a mask with exactly that many cards (mask-cw-row-<n>.png; 8 or more: mask-cw-row.png). id: 594 | 595. -->
    <include name="Netflix_Loading_CW_Row">
        <param name="id">594</param>
        <param name="condition">true</param>
        <definition>
            <include content="Netflix_Loading_Card"><param name="left">70</param><param name="top">102</param><param name="width">220</param><param name="height">330</param><param name="mask">diffuse/poster_w480_h720.png</param><param name="visible">String.IsEmpty(Skin.String(Netflix.CW.Count.$PARAM[id])) | Integer.IsGreater(Skin.String(Netflix.CW.Count.$PARAM[id]),0)</param></include>
