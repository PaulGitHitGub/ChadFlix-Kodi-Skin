<?xml version="1.0" encoding="UTF-8"?>
<window>
    <onload>ClearProperty(OSDRelaunchFullscreen,Home)</onload>
    <!-- Subtitle picker: only after playback stopped/ended while it was open (restore pending), turn that file's
         subtitles back on. Runs nothing otherwise. -->
    <onload condition="!String.IsEmpty(Skin.String(Netflix.Sub.RestoreFile))">RunScript(special://skin/extras/netflix_subtitle_style.py,restore)</onload>
    <controls>
        <control type="grouplist" id="0">
            <orientation>vertical</orientation>
            <centertop>100</centertop>
            <height>120</height>
            <left>80</left>
            <include content="Overlay_InfoLabel">
                <param name="id">10</param>
                <textcolor>panel_fg_100</textcolor>
                <textoffsetx>10</textoffsetx>
                <font>font_mini</font>
            </include>
            <include content="Overlay_InfoLabel">
                <param name="id">11</param>
                <textcolor>panel_fg_100</textcolor>
                <textoffsetx>10</textoffsetx>
                <font>font_mini</font>
            </include>
            <include content="Overlay_InfoLabel">
                <param name="id">12</param>
                <textcolor>panel_fg_100</textcolor>
                <textoffsetx>10</textoffsetx>
                <font>font_mini</font>
            </include>
        </control>
    </controls>
</window>