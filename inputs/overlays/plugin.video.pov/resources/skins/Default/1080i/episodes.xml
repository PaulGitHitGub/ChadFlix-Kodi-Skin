<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">11</defaultcontrol>
	<controls>
		<control type="image">
			<visible>String.IsEqual(Window.Property(tikiskins.nextep_function),confirm)</visible>
			<animation effect="fade" start="0" end="100" delay="400" time="500">WindowOpen</animation>
			<left>35</left>
			<top>20</top>
			<width>60</width>
			<height>60</height>
			<aspectratio aligny="top">keep</aspectratio>
			<texture>$INFO[Window.Property(tikiskins.pov.icon)]</texture>
		</control>
		<control type="group">
			<visible>String.IsEqual(Window.Property(tikiskins.nextep_function),confirm)</visible>
			<animation type="WindowOpen" reversible="false">
				<effect type="slide" start="0,-268" end="0,0" time="350" />
			</animation>
			<left>35</left>
			<top>0</top>
			<width>1850</width>
			<height>260</height>
			<control type="image">
				<right>0</right>
				<top>85</top>
				<width max="170">auto</width>
				<height>200</height>
				<aspectratio>stretch</aspectratio>
				<texture>$INFO[Window.Property(tikiskins.poster)]</texture>
			</control>
			<!-- Confirm -->
			<control type="group">
				<control type="label">
					<top>5</top>
					<height>30</height>
					<font>font12</font>
					<align>right</align>
					<aligny>top</aligny>
					<label>$INFO[Window.Property(tikiskins.title)]</label>
					<textcolor>FFB7B4BB</textcolor>
					<autoscroll>true</autoscroll>
				</control>
				<control type="label">
					<top>40</top>
					<height>30</height>
					<font>font12</font>
					<align>right</align>
					<aligny>top</aligny>
					<label>[B]$INFO[Window.Property(tikiskins.nextep_prompt)][/B]</label>
					<textcolor>FFB7B4BB</textcolor>
				</control>
				<control type="grouplist">
					<orientation>vertical</orientation>
					<align>center</align>
					<itemgap>20</itemgap>
					<right>180</right>
					<top>85</top>
					<width>80</width>
					<height>200</height>
					<control type="button" id="11">
						<description>Yes</description>
						<animation effect="zoom" start="100" end="102" time="50" tween="sine" easing="inout" center="auto">Focus</animation>
						<animation effect="zoom" start="102" end="100" time="50" tween="sine" easing="inout" center="auto">Unfocus</animation>
						<left>0</left>
						<width>70</width>
						<height>45</height>
						<onleft>10</onleft>
						<onright>10</onright>
						<label />
						<font>font10</font>
						<textcolor>FFB7B4BB</textcolor>
						<focusedcolor>FF302F2F</focusedcolor>
						<texturefocus colordiffuse="FFB7B4BB">play_button.png</texturefocus>
						<texturenofocus colordiffuse="FF4a4347">play_button.png</texturenofocus>
						<align>center</align>
					</control>
					<control type="button" id="10">
						<description>No</description>
						<animation effect="zoom" start="100" end="102" time="100" tween="sine" easing="inout" center="auto">Focus</animation>
						<animation effect="zoom" start="102" end="100" time="100" tween="sine" easing="inout" center="auto">Unfocus</animation>
						<left>0</left>
						<width>70</width>
						<height>45</height>
						<onleft>11</onleft>
						<onright>11</onright>
						<label />
						<font>font10</font>
						<textcolor>FFB7B4BB</textcolor>
						<focusedcolor>FF302F2F</focusedcolor>
						<texturefocus colordiffuse="FFB7B4BB">play_close_button.png</texturefocus>
						<texturenofocus colordiffuse="FF4a4347">play_close_button.png</texturenofocus>
						<align>center</align>
					</control>
				</control>
			</control>
			<control type="progress" id="5000">
				<description>Progressbar</description>
				<top>290</top>
				<right>0</right>
				<width>260</width>
				<height>17</height>
				<reveal>true</reveal>
			</control>
		</control>
		<control type="group">
			<width>1920</width>
			<height>1080</height>
			<visible>String.IsEqual(Window.Property(tikiskins.nextep_function),skip_intro)</visible>
			<control type="button" id="15">
				<right>80</right>
				<bottom>84</bottom>
				<width>246</width>
				<height>68</height>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>18</textoffsetx>
				<font>font12</font>
				<label>[B]Skip Intro[/B]</label>
				<textcolor>FFF5F5F5</textcolor>
				<focusedcolor>FF141414</focusedcolor>
				<texturefocus border="24" colordiffuse="FFF5F5F5">source-pill.png</texturefocus>
				<texturenofocus border="24" colordiffuse="E62B2B2B">source-pill.png</texturenofocus>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<onup>noop</onup>
				<ondown>noop</ondown>
			</control>
		</control>
		<control type="group">
			<width>1920</width>
			<height>1080</height>
			<visible>String.IsEqual(Window.Property(tikiskins.nextep_function),next_ep)</visible>
			<control type="button" id="14">
				<right>474</right>
				<bottom>84</bottom>
				<width>258</width>
				<height>68</height>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>18</textoffsetx>
				<font>font12</font>
				<label>[B]Watch Credits[/B]</label>
				<textcolor>FFF5F5F5</textcolor>
				<focusedcolor>FF141414</focusedcolor>
				<texturefocus border="24" colordiffuse="FFF5F5F5">source-pill.png</texturefocus>
				<texturenofocus border="24" colordiffuse="E62B2B2B">source-pill.png</texturenofocus>
				<onleft>noop</onleft>
				<onright>13</onright>
				<onup>noop</onup>
				<ondown>noop</ondown>
			</control>
			<control type="button" id="13">
				<right>80</right>
				<bottom>84</bottom>
				<width>378</width>
				<height>68</height>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>18</textoffsetx>
				<font>font12</font>
				<label>[B]Next Episode[/B]$INFO[Player.TimeRemaining,  ·  ]</label>
				<textcolor>FFF5F5F5</textcolor>
				<focusedcolor>FF141414</focusedcolor>
				<texturefocus border="24" colordiffuse="FFF5F5F5">source-pill.png</texturefocus>
				<texturenofocus border="24" colordiffuse="E62B2B2B">source-pill.png</texturenofocus>
				<onleft>14</onleft>
				<onright>noop</onright>
				<onup>noop</onup>
				<ondown>noop</ondown>
			</control>
		</control>
	</controls>
</window>

